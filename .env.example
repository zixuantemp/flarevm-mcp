# flarevm-mcp configuration
# Copy to .env (same directory as server.py). Process environment variables
# take precedence over this file. .env is git-ignored — never commit it.

# ── Required ────────────────────────────────────────────────────────────────
# IP of the FlareVM on the isolated lab network. No default on purpose: a stale
# address fails as a silent WinRM timeout, not an error.
FLAREVM_HOST=192.168.167.10

# ── Credentials ─────────────────────────────────────────────────────────────
FLAREVM_USER=xtemp
# Prefer the OS keyring (service "flarevm", username = FLAREVM_USER); setup.py
# stores it there. Only set this if you cannot use a keyring (e.g. Docker).
#FLAREVM_PASSWORD=

# ── File transfer (uploads/downloads > 8 KB go over SMB) ────────────────────
FLAREVM_SMB_SHARE=KaliShare
FLAREVM_SMB_LOCAL_PATH=C:\Share

# ── Optional ────────────────────────────────────────────────────────────────
# Analyst-host IP placed in FakeNet's HostBlackList so the VM never intercepts
# the server's own WinRM/SMB traffic. Auto-detected as the local address that
# routes to FLAREVM_HOST; set only if that picks the wrong interface.
#KALI_IP=192.168.167.50

# Port of the WinDbg MCP proxy on the VM.
#WINDBG_MCP_PORT=13338

# ── Hardening (1.2.0) ───────────────────────────────────────────────────────
# WinRM over HTTPS (listener on 5986). Without FLAREVM_CA_BUNDLE the certificate
# is NOT validated. NTLM is always used; Basic auth is never required.
#FLAREVM_WINRM_SCHEME=http
#FLAREVM_WINRM_PORT=5985
#FLAREVM_CA_BUNDLE=/path/to/flarevm-ca.pem

# Availability: concurrent WinRM operations, output cap (bytes), pywinrm HTTP
# read/operation timeouts (read must exceed operation), circuit breaker.
#FLAREVM_MAX_CONCURRENT=4
#FLAREVM_MAX_OUTPUT=1048576
#FLAREVM_READ_TIMEOUT=60
#FLAREVM_OPERATION_TIMEOUT=30
#FLAREVM_BREAKER_THRESHOLD=3
#FLAREVM_BREAKER_COOLDOWN=30

# Integrity: SHA256 manifest of the analysis tools on the VM (record it with
# verify_tools(record=true) on a clean snapshot). Strict mode defaults to ON
# once the manifest exists and blocks tools whose binaries changed.
#FLAREVM_TOOL_MANIFEST=./tool_manifest.json
#FLAREVM_STRICT_INTEGRITY=1

# Kali-side path allow-lists (colon separated). Uploads may only read from,
# and downloads may only write to, these directories.
#FLAREVM_ALLOWED_UPLOAD_ROOTS=~/Desktop:~/Downloads
#FLAREVM_ALLOWED_DOWNLOAD_ROOTS=~/Desktop/analysis

# Snapshot hooks (run on this host). Auto-detects vmrun (.vmx), VBoxManage, virsh.
#FLAREVM_VM_ID=/path/to/FlareVM.vmx
#FLAREVM_CLEAN_SNAPSHOT=clean
#FLAREVM_REQUIRE_CLEAN_SNAPSHOT=1
#FLAREVM_SNAPSHOT_LIST_CMD="vmrun listSnapshots {vm}"
#FLAREVM_SNAPSHOT_REVERT_CMD="vmrun revertToSnapshot {vm} {name}"
#FLAREVM_SNAPSHOT_CREATE_CMD="vmrun snapshot {vm} {name}"
