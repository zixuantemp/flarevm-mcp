# flarevm-mcp configuration
# Copy to .env (same directory as server.py). Process environment variables
# take precedence over this file. .env is git-ignored — never commit it.

# ── Required ────────────────────────────────────────────────────────────────
# IP of the FlareVM on the isolated lab network. No default on purpose: a stale
# address fails as a silent WinRM timeout, not an error.
FLAREVM_HOST=192.168.167.10

# ── Credentials ─────────────────────────────────────────────────────────────
FLAREVM_USER=xtemp
# Prefer the OS keyring (service "flarevm", username = FLAREVM_USER); setup.py
# stores it there. Only set this if you cannot use a keyring (e.g. Docker).
#FLAREVM_PASSWORD=

# ── File transfer (uploads/downloads > 8 KB go over SMB) ────────────────────
FLAREVM_SMB_SHARE=KaliShare
FLAREVM_SMB_LOCAL_PATH=C:\Share

# ── Optional ────────────────────────────────────────────────────────────────
# Analyst-host IP placed in FakeNet's HostBlackList so the VM never intercepts
# the server's own WinRM/SMB traffic. Auto-detected as the local address that
# routes to FLAREVM_HOST; set only if that picks the wrong interface.
#KALI_IP=192.168.167.50

# Port of the WinDbg MCP proxy on the VM.
#WINDBG_MCP_PORT=13338
